generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RESIDENT
  TECHNICIAN
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  email        String      @unique
  passwordHash String
  role         UserRole
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  resident     Resident?
  technician   Technician?

  @@index([role])
  @@index([isActive])
}

model Apartment {
  id         String     @id @default(uuid()) @db.Uuid
  block      String
  floor      Int
  unitNumber String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  residents  Resident[]

  @@unique([block, unitNumber])
  @@index([block])
  @@index([floor])
}

model Resident {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid
  apartmentId String    @db.Uuid
  phone       String
  moveInDate  DateTime  @db.Date
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  apartment   Apartment @relation(fields: [apartmentId], references: [id])

  @@index([apartmentId])
  @@index([isActive])
  @@index([moveInDate])
}

model MaintenanceCategory {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  technicianSkills TechnicianSkill[]

  @@index([isActive])
}

model Technician {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @unique @db.Uuid
  phone           String
  experienceYears Int
  isAvailable     Boolean           @default(true)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  user            User              @relation(fields: [userId], references: [id])
  skills          TechnicianSkill[]

  @@index([isActive])
  @@index([isAvailable])
}

model TechnicianSkill {
  id           String              @id @default(uuid()) @db.Uuid
  technicianId String              @db.Uuid
  categoryId   String              @db.Uuid
  createdAt    DateTime            @default(now())
  technician   Technician          @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     MaintenanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([technicianId, categoryId])
  @@index([categoryId])
}
