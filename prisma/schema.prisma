generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RESIDENT
  TECHNICIAN
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String
  email              String                  @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  resident           Resident?
  technician         Technician?
  assignmentsCreated MaintenanceAssignment[] @relation("AssignmentCreator")

  @@index([role])
  @@index([isActive])
}

model Apartment {
  id                  String               @id @default(uuid()) @db.Uuid
  block               String
  floor               Int
  unitNumber          String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  residents           Resident[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([block, unitNumber])
  @@index([block])
  @@index([floor])
}

model Resident {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @db.Uuid
  apartmentId         String               @db.Uuid
  phone               String
  moveInDate          DateTime             @db.Date
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  apartment           Apartment            @relation(fields: [apartmentId], references: [id])
  maintenanceRequests MaintenanceRequest[]

  @@index([apartmentId])
  @@index([isActive])
  @@index([moveInDate])
}

model MaintenanceCategory {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  technicianSkills    TechnicianSkill[]
  maintenanceRequests MaintenanceRequest[]

  @@index([isActive])
}

model MaintenanceRequest {
  id          String                  @id @default(uuid()) @db.Uuid
  residentId  String                  @db.Uuid
  apartmentId String                  @db.Uuid
  categoryId  String                  @db.Uuid
  title       String
  description String
  priority    MaintenancePriority
  status      MaintenanceStatus       @default(OPEN)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  resident    Resident                @relation(fields: [residentId], references: [id])
  apartment   Apartment               @relation(fields: [apartmentId], references: [id])
  category    MaintenanceCategory     @relation(fields: [categoryId], references: [id])
  assignments MaintenanceAssignment[]

  @@index([residentId])
  @@index([apartmentId])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model Technician {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @unique @db.Uuid
  phone           String
  experienceYears Int
  isAvailable     Boolean                 @default(true)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id])
  skills          TechnicianSkill[]
  assignments     MaintenanceAssignment[]

  @@index([isActive])
  @@index([isAvailable])
}

model MaintenanceAssignment {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @db.Uuid
  technicianId         String             @db.Uuid
  assignedByUserId     String             @db.Uuid
  assignedAt           DateTime           @default(now())
  unassignedAt         DateTime?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  technician           Technician         @relation(fields: [technicianId], references: [id])
  assignedBy           User               @relation("AssignmentCreator", fields: [assignedByUserId], references: [id])

  @@index([maintenanceRequestId])
  @@index([technicianId])
  @@index([assignedByUserId])
  @@index([isActive])
  @@index([technicianId, isActive])
}

model TechnicianSkill {
  id           String              @id @default(uuid()) @db.Uuid
  technicianId String              @db.Uuid
  categoryId   String              @db.Uuid
  createdAt    DateTime            @default(now())
  technician   Technician          @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     MaintenanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([technicianId, categoryId])
  @@index([categoryId])
}
