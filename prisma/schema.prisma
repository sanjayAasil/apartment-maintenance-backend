generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  RESIDENT
  TECHNICIAN
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenanceHistoryAction {
  REQUEST_CREATED
  REQUEST_UPDATED
  STATUS_CHANGED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_REASSIGNED
  TECHNICIAN_UNASSIGNED
  COMMENT_ADDED
  CATEGORY_CHANGED
  PRIORITY_CHANGED
  WORK_NOTE_CREATED
  WORK_NOTE_UPDATED
  PART_ADDED
  PART_REMOVED
}

model User {
  id                  String                  @id @default(uuid()) @db.Uuid
  name                String
  email               String                  @unique
  passwordHash        String
  role                UserRole
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  resident            Resident?
  technician          Technician?
  assignmentsCreated  MaintenanceAssignment[] @relation("AssignmentCreator")
  maintenanceComments MaintenanceComment[]
  maintenanceHistory  MaintenanceHistory[]

  @@index([role])
  @@index([isActive])
}

model Apartment {
  id                  String               @id @default(uuid()) @db.Uuid
  block               String
  floor               Int
  unitNumber          String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  residents           Resident[]
  maintenanceRequests MaintenanceRequest[]

  @@unique([block, unitNumber])
  @@index([block])
  @@index([floor])
}

model Resident {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String               @unique @db.Uuid
  apartmentId         String               @db.Uuid
  phone               String
  moveInDate          DateTime             @db.Date
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  apartment           Apartment            @relation(fields: [apartmentId], references: [id])
  maintenanceRequests MaintenanceRequest[]

  @@index([apartmentId])
  @@index([isActive])
  @@index([moveInDate])
}

model MaintenanceCategory {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String               @unique
  description         String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  technicianSkills    TechnicianSkill[]
  maintenanceRequests MaintenanceRequest[]

  @@index([isActive])
}

model MaintenanceRequest {
  id          String                   @id @default(uuid()) @db.Uuid
  residentId  String                   @db.Uuid
  apartmentId String                   @db.Uuid
  categoryId  String                   @db.Uuid
  title       String
  description String
  priority    MaintenancePriority
  status      MaintenanceStatus        @default(OPEN)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  resident    Resident                 @relation(fields: [residentId], references: [id])
  apartment   Apartment                @relation(fields: [apartmentId], references: [id])
  category    MaintenanceCategory      @relation(fields: [categoryId], references: [id])
  assignments MaintenanceAssignment[]
  comments    MaintenanceComment[]
  history     MaintenanceHistory[]
  workNote    MaintenanceWorkNote?
  parts       MaintenanceRequestPart[]

  @@index([residentId])
  @@index([apartmentId])
  @@index([categoryId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model MaintenanceComment {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @db.Uuid
  userId               String             @db.Uuid
  message              String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  user                 User               @relation(fields: [userId], references: [id])

  @@index([maintenanceRequestId])
  @@index([userId])
  @@index([createdAt])
}

model MaintenanceHistory {
  id                   String                   @id @default(uuid()) @db.Uuid
  maintenanceRequestId String                   @db.Uuid
  userId               String?                  @db.Uuid
  action               MaintenanceHistoryAction
  oldValue             String?
  newValue             String?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  maintenanceRequest   MaintenanceRequest       @relation(fields: [maintenanceRequestId], references: [id])
  user                 User?                    @relation(fields: [userId], references: [id])

  @@index([maintenanceRequestId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Technician {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @unique @db.Uuid
  phone           String
  experienceYears Int
  isAvailable     Boolean                 @default(true)
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id])
  skills          TechnicianSkill[]
  assignments     MaintenanceAssignment[]
  workNotes       MaintenanceWorkNote[]

  @@index([isActive])
  @@index([isAvailable])
}

model MaintenanceWorkNote {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @unique @db.Uuid
  technicianId         String             @db.Uuid
  diagnosis            String
  workPerformed        String
  laborCost            Decimal            @default(0) @db.Decimal(12, 2)
  otherCost            Decimal            @default(0) @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  technician           Technician         @relation(fields: [technicianId], references: [id])

  @@index([technicianId])
}

model Part {
  id           String                   @id @default(uuid()) @db.Uuid
  name         String                   @unique
  description  String?
  quantity     Int                      @default(0)
  unitPrice    Decimal                  @db.Decimal(12, 2)
  minimumStock Int                      @default(0)
  isActive     Boolean                  @default(true)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  usages       MaintenanceRequestPart[]

  @@index([isActive])
  @@index([quantity])
}

model MaintenanceRequestPart {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @db.Uuid
  partId               String             @db.Uuid
  quantity             Int
  unitPrice            Decimal            @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  part                 Part               @relation(fields: [partId], references: [id])

  @@index([maintenanceRequestId])
  @@index([partId])
  @@index([createdAt])
}

model MaintenanceAssignment {
  id                   String             @id @default(uuid()) @db.Uuid
  maintenanceRequestId String             @db.Uuid
  technicianId         String             @db.Uuid
  assignedByUserId     String             @db.Uuid
  assignedAt           DateTime           @default(now())
  unassignedAt         DateTime?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  maintenanceRequest   MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id])
  technician           Technician         @relation(fields: [technicianId], references: [id])
  assignedBy           User               @relation("AssignmentCreator", fields: [assignedByUserId], references: [id])

  @@index([maintenanceRequestId])
  @@index([technicianId])
  @@index([assignedByUserId])
  @@index([isActive])
  @@index([technicianId, isActive])
}

model TechnicianSkill {
  id           String              @id @default(uuid()) @db.Uuid
  technicianId String              @db.Uuid
  categoryId   String              @db.Uuid
  createdAt    DateTime            @default(now())
  technician   Technician          @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  category     MaintenanceCategory @relation(fields: [categoryId], references: [id])

  @@unique([technicianId, categoryId])
  @@index([categoryId])
}
